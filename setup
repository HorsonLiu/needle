#!/usr/bin/env bash

set -e

VENV_DIR=".venv"
MIN_PYTHON="3.10"

_needle_setup_sourced=0
if [ "${BASH_SOURCE[0]}" != "$0" ]; then
    _needle_setup_sourced=1
fi

_needle_setup_had_errexit=0
case $- in
    *e*) _needle_setup_had_errexit=1 ;;
esac

_needle_setup_restore_shell_state() {
    if [ "$_needle_setup_sourced" = "1" ] && [ "$_needle_setup_had_errexit" = "0" ]; then
        set +e
    fi
    trap - INT TERM
}

_needle_setup_die() {
    local code="${1:-1}"
    _needle_setup_restore_shell_state
    if [ "$_needle_setup_sourced" = "1" ]; then
        return "$code"
    fi
    exit "$code"
}

_needle_setup_on_interrupt() {
    echo ""
    echo "setup interrupted."
    _needle_setup_die 130
}

trap _needle_setup_on_interrupt INT TERM

version_ok() {
    "$1" -c "import sys; print(int(sys.version_info >= (3, 10)))" 2>/dev/null
}

find_python() {
    for candidate in python3.13 python3.12 python3.11 python3.10 python3; do
        if command -v "$candidate" >/dev/null 2>&1 && [ "$(version_ok "$candidate")" = "1" ]; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

if [ -n "${VIRTUAL_ENV:-}" ] || [ -n "${CONDA_PREFIX:-}" ]; then
    PYTHON="${PYTHON:-python}"
    if [ "$(version_ok "$PYTHON")" != "1" ]; then
        echo "Error: active virtual environment uses Python < ${MIN_PYTHON}."
        _needle_setup_die 1
    fi
    ACTIVE_ENV="${VIRTUAL_ENV:-$CONDA_PREFIX}"
    echo "Using active virtual environment: $ACTIVE_ENV"
elif [ -f "$VENV_DIR/bin/activate" ]; then
    source "$VENV_DIR/bin/activate"
    PYTHON="${PYTHON:-python}"
    if [ "$(version_ok "$PYTHON")" != "1" ]; then
        echo "Error: $VENV_DIR uses Python < ${MIN_PYTHON}. Recreate it manually if needed."
        _needle_setup_die 1
    fi
    echo "Using existing virtual environment: $VENV_DIR"
else
    PYTHON="${PYTHON:-$(find_python || true)}"
    if [ -z "$PYTHON" ]; then
        echo "Error: Python >= ${MIN_PYTHON} is required."
        echo "Create or activate a compatible virtual environment first."
        _needle_setup_die 1
    fi
    echo "Creating virtual environment with $PYTHON..."
    "$PYTHON" -m venv "$VENV_DIR"
    source "$VENV_DIR/bin/activate"
fi

echo "Installing project dependencies..."
python -m pip install -e .

if [ -n "${NEEDLE_EXTRAS:-}" ]; then
    echo "Installing optional extras: ${NEEDLE_EXTRAS}"
    python -m pip install -e ".[${NEEDLE_EXTRAS}]"
else
    cat <<'EOF'

Optional extras are not installed automatically.
Install them only if you need them, for example:
  python -m pip install -e ".[gpu]"
  python -m pip install -e ".[tpu]"
  python -m pip install -e ".[train]"
  python -m pip install -e ".[cloud]"

Or set NEEDLE_EXTRAS before running this script:
  NEEDLE_EXTRAS=gpu ./setup

EOF
fi

python -c "import jax; print('JAX devices:', jax.devices())" 2>/dev/null || \
    echo "Warning: jax import failed; install the appropriate JAX build for your environment."

needle --help

_needle_setup_restore_shell_state
